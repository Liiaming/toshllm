+    const int s = g.slot_of[key];
+    if (s >= 0 && g.ref[s] == 0 && g.state[s] == RESIDENT) {
+        if (copy == TOSH_HC_COPY_FREE) {
+            g.lru_unlink(s);
+            g.slot_of[key] = -1;
+            g.key_of[s] = -1;
+            g.state[s] = EMPTY;
+            auto & pl = g.pools[g.pool_of_slot[s]];
+            pl.free_slots.push_back(s);
