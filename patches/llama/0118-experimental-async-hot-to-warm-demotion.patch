+static bool ggml_metal_dmoe_host_region(void * ctx_raw, void * base, size_t len, size_t piece) {
+    struct ggml_metal_dmoe_up * up = ctx_raw;
+    if (up->down_stage) {
+        [up->lock lock];
+        if (up->down_ring == nil && getenv("TOSH_DMOE_TEST_RING_FAIL") == NULL) {
+            up->down_ring = [up->dev->mtl_device newBufferWithLength:(size_t) 64*(2u << 20) options:MTLResourceStorageModeShared];
+        }
+        const bool ok = up->down_ring != nil;
+        [up->lock unlock];
+        return ok;
+    }
+    bool ok = true;
+    [up->lock lock];
+    for (size_t o = 0; o < len && ok; o += piece) {
+        const size_t l = MIN(piece, len - o);
+        if (up->n_regions == 1024) { ok = false; break; }
+        id<MTLBuffer> buf = [up->dev->mtl_device newBufferWithBytesNoCopy:(char *) base + o length:l
+                                                                   options:MTLResourceStorageModeShared deallocator:nil];
+        if (buf == nil) { ok = false; break; }
+        up->regions[up->n_regions].base = (char *) base + o;
+        up->regions[up->n_regions].len  = l;
+        up->regions[up->n_regions].buf  = buf;
+        up->n_regions++;
+    }
+    [up->lock unlock];
+    return ok;
+}
