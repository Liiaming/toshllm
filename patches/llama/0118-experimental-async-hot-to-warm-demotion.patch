+            g.dem_failed++;
+            g.fallback_reads++;
+            g.enq_t[s] = now_us();
+            g.bg[s] = 1;
+            (g.bg_io > 0 ? g.bgq : g.queue).push_back(s);
+            (g.bg_io > 0 ? g.bg_work : g.work).notify_one();
+            return;
+        }
+        g.dem_done++;
+        if (g.dem_us.size() < (1u << 22)) g.dem_us.push_back((float) (now_us() - g.dem_t0[s]));
+        // TOSH_DMOE_HOST_DEMOTE_CHECK=k: one copy in k is compared with the file
+        static const int check = getenv("TOSH_DMOE_HOST_DEMOTE_CHECK") ? atoi(getenv("TOSH_DMOE_HOST_DEMOTE_CHECK")) : 0;
+        if (check > 0 && g.dem_done % check == 0) {
