+static uint64_t ggml_metal_dmoe_download(void * ctx_raw, const struct tosh_dmoe_copy * copies, int n, void (*done)(void * arg, int ok), void * arg) {
+    struct ggml_metal_dmoe_up * up = ctx_raw;
