+char * tosh_hostcache_demote_begin(int il, int e) {
+    std::lock_guard<std::mutex> lock(g.m);
+    const int key = il*g.n_expert + e;
+    if (g.base == nullptr) return nullptr;
+    if (g.slot_of[key] >= 0) {
+        const int s = g.slot_of[key];
+        if (g.ref[s] == 0 && g.state[s] == RESIDENT && g.in_lru(s)) { g.lru_unlink(s); g.lru_push(s); }
+        g.dem_kept++;
+        return nullptr;
+    }
+    const int s = g.take_slot(il);
+    if (s < 0) { g.dem_no_slot++; return nullptr; }
+    g.key_of[s] = key;
+    g.slot_of[key] = s;
+    g.state[s] = LOADING;
+    g.ref[s] = 0;
+    g.bg[s] = 0;
+    g.bg_unused[s] = 0;
+    g.demoting[s] = 1;
+    g.dem_t0[s] = now_us();
+    g.ever[key] = 1;
+    g.dem_started++;
+    return g.slot_ptr(s);
