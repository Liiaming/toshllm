+                    atomic_store(busy, 0);
+                    done(arg, ok);
+                });
+            }];
+            [cb commit];
+            [cb retain];
+            if (up->down_ring_cb[e] != nil) [up->down_ring_cb[e] release];
+            up->down_ring_cb[e] = [cb retain];
+            id<MTLCommandBuffer> old = up->down_tickets[ticket % DMOE_UP_TICKETS];
+            up->down_tickets[ticket % DMOE_UP_TICKETS] = cb;
+            [up->lock unlock];
+            if (old != nil) [old release];
+            return ticket | DMOE_DOWN_BIT;
+        }
+        for (int i = 0; i < n; ++i) {
+            const struct ggml_tensor * t = copies[i].dst;
+            ggml_backend_buffer_t buffer = t->view_src ? t->view_src->buffer : t->buffer;
+            struct ggml_metal_buffer_id src = ggml_metal_buffer_get_id(buffer->context, t);
+            const char * host = copies[i].src;
+            int r = 0;
+            while (r < up->n_regions && !(host >= up->regions[r].base && host + copies[i].size <= up->regions[r].base + up->regions[r].len)) r++;
