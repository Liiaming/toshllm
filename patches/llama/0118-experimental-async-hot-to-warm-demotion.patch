+                struct ggml_metal_buffer_id src = ggml_metal_buffer_get_id(buffer->context, t);
+                if (src.metal == nil || off + copies[i].size > slot) {
+                    [blit endEncoding];
+                    [up->lock unlock];
+                    return 0;
+                }
+                [blit copyFromBuffer:src.metal sourceOffset:src.offs + copies[i].offset toBuffer:up->down_ring
+                   destinationOffset:(size_t) e*slot + off size:copies[i].size];
+                outs[i].host = (char *) copies[i].src; outs[i].off = (size_t) e*slot + off; outs[i].size = copies[i].size;
+                off += copies[i].size;
+            }
+            [blit endEncoding];
+            const char * ring = [up->down_ring contents];
+            const int nn = MIN(n, 4);
+            size_t * o = malloc(sizeof(size_t)*3*nn);
+            for (int i = 0; i < nn; ++i) { o[3*i] = (size_t) outs[i].host; o[3*i + 1] = outs[i].off; o[3*i + 2] = outs[i].size; }
