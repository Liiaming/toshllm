+        // 5. publish a table with what is resident now, into a version no graph can be reading
+        if (dirty) {
+            int next = -1;
+            for (int k = 1; k < TOSH_DMOE_VERSIONS; ++k) {
+                const int v = (cur_version + k) % TOSH_DMOE_VERSIONS;
