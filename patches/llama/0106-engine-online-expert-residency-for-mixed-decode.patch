+                free_list[il].pop_back();
+                slot & sl = slots[(size_t) il*Q + s];
+                const llama_tosh_dmoe_layer * dl = layers[il];
+                const host_bank & b = (*banks)[il];
+                tosh_dmoe_copy copies[3] = {
+                    { dl->arena_gate, (size_t) s*dl->arena_gate->nb[2], (const char *) b.gate->data + (size_t) e*b.gate->nb[2], dl->arena_gate->nb[2] },
+                    { dl->arena_up,   (size_t) s*dl->arena_up->nb[2],   (const char *) b.up->data   + (size_t) e*b.up->nb[2],   dl->arena_up->nb[2]   },
+                    { dl->arena_down, (size_t) s*dl->arena_down->nb[2], (const char *) b.down->data + (size_t) e*b.down->nb[2], dl->arena_down->nb[2] },
+                };
