+    double   us_cycle = 0, us_drain = 0, us_decide = 0, us_publish = 0, us_upload_call = 0;
+    double   us_upload_wall = 0, us_upload_gpu = 0;
+    uint64_t lifetime_sum = 0, lifetime_n = 0, uses_sum = 0;
